# Токен від @BotFather
BOT_TOKEN=123456789:replace-me

# Локальний запуск (без Docker). У docker-compose ця змінна перевизначається.
DATABASE_URL=postgresql+asyncpg://skynemos:skynemos@localhost:5432/skynemos

# Облікові дані для контейнера postgres
POSTGRES_USER=skynemos
POSTGRES_PASSWORD=skynemos
POSTGRES_DB=skynemos

TIMEZONE=Europe/Kyiv
BILLING_HOUR=10
LOG_LEVEL=INFO

# Опційно: FSM-стан у Redis (діалог /new переживає перезапуск). У docker-compose задано автоматично.
# REDIS_URL=redis://localhost:6379/0

# Опційно: звіти про помилки в Sentry (безкоштовний план на sentry.io)
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# ENVIRONMENT=production
